/*
===============================================================================
Data Loading Script: Ingest Raw CSV Data into Bronze Layer
===============================================================================
Script Purpose:
    This script truncates and loads raw source data files (CSV) into the 
    corresponding Bronze staging tables using BULK INSERT.
    
    Load Strategy: Full Refresh (Truncate and Load)
    Source Systems:
        1. CRM Datasets (Customer Info, Product Info, Sales Details)
        2. ERP Datasets (Customer Demographics, Customer Locations, Product Categories)
===============================================================================
*/

-- =============================================================================
-- 1. LOAD CRM SOURCE DATA
-- =============================================================================

-------------------------------------------------------------------------------
-- Loading Table: bronze.crm_cust_info
-- Source: cust_info.csv
-------------------------------------------------------------------------------

-- Step 1: Empty the target staging table to prevent duplicate records
TRUNCATE TABLE bronze.crm_cust_info;

-- Step 2: Bulk load the CSV file into the target table
BULK INSERT bronze.crm_cust_info
FROM 'C:\Users\HP\OneDrive\Desktop\SQL\sql-data-warehouse-project\datasets\source_crm\cust_info.csv'
WITH (
    FIRSTROW = 2,           -- Skip the header row
    FIELDTERMINATOR = ',',  -- Comma-delimited file format
    TABLOCK                 -- Minimizes transaction logging and speeds up bulk insert
);

